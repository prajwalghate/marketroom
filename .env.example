# Marketroom — environment
#
# Nothing here is required: every data source is public, and without a
# database the app keeps an embedded one. Production should set DATABASE_URL,
# ADMIN_TOKENS and CRON_SECRET (see the research database section below).

# --- Hyperliquid ---
NEXT_PUBLIC_HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
NEXT_PUBLIC_HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# The builder-deployed perp DEX carrying tokenized equities (trade[XYZ]).
NEXT_PUBLIC_HYPERLIQUID_DEX=xyz

# --- Solana / Jupiter ---
NEXT_PUBLIC_JUPITER_API_URL=https://lite-api.jup.ag
# Read once per measurement pass, for each xStock's on-chain UI multiplier
# (splits and dividends). Any mainnet RPC works; the public one is the default.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Caching ---
# Seconds the server-side market snapshot is reused before refetching.
SNAPSHOT_REVALIDATE_SECONDS=15

# --- Solana research (all optional) ---
# DefiLlama API plan key. Without it, funding rounds are assembled from each
# project's public record (free, DeFi projects only). With it, the complete
# Solana funding feed is one request.
DEFILLAMA_API_KEY=
# CoinGecko demo key, for all-time highs and 7-day sparklines on token pages.
# Never called without a key: the keyless tier rate-limits within minutes.
COINGECKO_API_KEY=


# --- Research database ---
# Postgres connection string (Neon, Supabase, RDS, local). Without it, the app
# uses an embedded Postgres (PGlite) under apps/web/.data/ — nothing to install,
# one server process. On Vercel it falls back to /tmp, per instance, rebuilt
# after every cold start. Production should always set this.
DATABASE_URL=
# Where the embedded database lives when DATABASE_URL is not set.
PGLITE_DIR=

# Editors, as name:token pairs (tokens at least 16 characters). Each editor's
# name goes into the change log with every edit. Without any, the editors'
# dashboard is open in development and does not exist in production.
ADMIN_TOKENS=
# ...or one token, signed in as "admin".
ADMIN_TOKEN=

# Imports run in the background whenever pages are read ("lazy upkeep"); a
# scheduler can also call /api/cron/upkeep with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Set to "off" to leave scheduling to the cron route alone.
MARKETROOM_UPKEEP=

# GitHub token for the people import: 5,000 requests an hour instead of 60.
GITHUB_TOKEN=

# Log embedded-database queries slower than this many milliseconds (debugging).
MARKETROOM_SLOW_QUERY_MS=
